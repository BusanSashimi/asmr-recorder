{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "asmr-recorder",
  "version": "0.1.0",
  "identifier": "com.asmrrecorder.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "devUrl": "http://localhost:5178",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ASMR Recorder",
        "label": "main",
        "width": 800,
        "height": 600,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "public.app-category.utilities",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "frameworks": [],
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwMkNCQjc5NzgyMjAxQzEKUldUQkFTSjRlYnNzWUl1OUUrbVhhanFaWWRLVm9kalIrMUpGUWpCOHVxM2xCZG9OTTJ5bkJ5bTQK",
      "endpoints": [
        "https://github.com/BusanSashimi/asmr-recorder/releases/latest/download/latest.json"
      ]
    }
  }
}
