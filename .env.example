# Apple signing & notarization credentials for `npm run tauri build`.
# Copy to .env (gitignored) and fill in your values.
# NEVER commit .env or these values to source control.

# ── Signing ──────────────────────────────────────────────────────────────────
# The exact name of your Developer ID Application certificate from Keychain.
# Find it with: security find-identity -v -p codesigning
# Example: "Developer ID Application: Jane Doe (TEAMID1234)"
APPLE_SIGNING_IDENTITY=""

# ── Notarization (choose ONE of the two methods below) ───────────────────────

# Method A — App Store Connect API key (recommended; no 2FA interruption)
APPLE_API_KEY=""        # Key ID, e.g. ABCD1234EF
APPLE_API_ISSUER=""     # Issuer UUID from App Store Connect
APPLE_API_KEY_PATH=""   # Absolute path to the downloaded .p8 key file

# Method B — Apple ID + app-specific password
# APPLE_ID=""           # Your Apple ID email
# APPLE_PASSWORD=""     # App-specific password (appstoreconnect.apple.com → Security)
# APPLE_TEAM_ID=""      # 10-char team ID (App Store Connect → Membership)
